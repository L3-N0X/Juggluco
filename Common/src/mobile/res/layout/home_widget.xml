<?xml version="1.0" encoding="utf-8"?>
<!-- Host for the drawn home screen widgets (tk.glucodata.widgets). The picture carries its own
     background and corners, so the frame itself stays transparent. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/home_widget_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter" />
</FrameLayout>
